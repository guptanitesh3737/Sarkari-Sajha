    "audit_logs": {
      "title": "Production Audit Trail",
      "description": "Granular administrative activity logs capturing resource, previous state, new state, and executor",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "resourceId": { "type": "string" },
        "details": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "action", "resource", "timestamp"]
    }
